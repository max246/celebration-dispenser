#pragma once

// Copy this file to `secrets.h` (same folder) and fill in your values.
// secrets.h is git-ignored so your credentials never get committed.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// Direct URLs to audio streams/files the MAX98357A will play. MP3 or AAC over
// HTTP(S) both work with ESP32-audioI2S, e.g.
//   #define AUDIO_URL "http://192.168.1.10:8000/tada.mp3"
#define AUDIO_URL      "http://example.com/celebrate.mp3"  // on each celebration

// Ambient sound looped while idle (used only if ENABLE_IDLE_AUDIO in config.h).
#define IDLE_AUDIO_URL "http://example.com/idle-loop.mp3"
