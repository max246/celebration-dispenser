# PlatformIO build output
firmware/.pio/
.pio/

# Secrets (WiFi creds + stream URL) — only needed for the streaming audio test
firmware/include/secrets.h

# On-board audio files (can be large / personal) — added locally, uploaded with uploadfs
firmware/data/*.mp3
firmware/data/*.wav

# Source audio originals (converted to WAV in firmware/data/) — often large / licensed
music/*.mp3
music/*.wav

# OpenSCAD editor backups
*.scad.bak

# OS cruft
.DS_Store
Thumbs.db
